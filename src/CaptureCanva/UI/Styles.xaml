<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <SolidColorBrush x:Key="StudioBackground" Color="#111317" />
    <SolidColorBrush x:Key="StudioSurface" Color="#1A1D23" />
    <SolidColorBrush x:Key="StudioInput" Color="#22262E" />
    <SolidColorBrush x:Key="StudioHover" Color="#2C313B" />
    <SolidColorBrush x:Key="StudioStroke" Color="#303640" />
    <SolidColorBrush x:Key="StudioText" Color="#F4F6FA" />
    <SolidColorBrush x:Key="StudioSecondary" Color="#ABB4C3" />
    <SolidColorBrush x:Key="StudioAccent" Color="#FF796F" />
    <SolidColorBrush x:Key="StudioAccentSurface" Color="#362629" />
    <SolidColorBrush x:Key="RecordBrush" Color="#FF796F" />
    <Geometry x:Key="MonitorIcon">M3,3 H21 V16 H3 Z M8,21 H16 M12,16 V21</Geometry>
    <Geometry x:Key="WindowIcon">M3,4 H21 V20 H3 Z M3,9 H21 M6,6.5 H7</Geometry>
    <Geometry x:Key="RegionIcon">M3,9 V3 H9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15 M9,12 H15 M12,9 V15</Geometry>
    <Geometry x:Key="FolderIcon">M3,7 V4 H10 L13,7 H21 V20 H3 Z M3,10 H21</Geometry>
    <Geometry x:Key="SettingsIcon">M4,6 H20 M4,12 H20 M4,18 H20 M9,3 V9 M16,9 V15 M9,15 V21</Geometry>
    <Geometry x:Key="LogIcon">M5,3 H15 L20,8 V21 H5 Z M15,3 V8 H20 M8,12 H16 M8,16 H14</Geometry>
    <Geometry x:Key="PauseIcon">M8,4 V20 M16,4 V20</Geometry>
    <Geometry x:Key="PlayIcon">M7,4 L20,12 L7,20 Z</Geometry>
    <Geometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="MinimizeIcon">M5,12 H19</Geometry>

    <Style x:Key="StudioWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource StudioBackground}" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Malgun Gothic" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StudioSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StudioButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StudioInput}" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioStroke}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Width="15" Height="15" Stretch="Uniform"
                                  Margin="0,0,8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.75" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                        <Path Data="{TemplateBinding Tag}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioHover}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource StudioSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="10,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" StrokeLineJoin="Round" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioHover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource StudioAccentSurface}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#95514E" />
                            <Setter Property="Foreground" Value="{StaticResource StudioAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StudioCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="FocusBorder" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="2,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="#3D4450" VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Fill="#CED4DF" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource StudioAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="#271714" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusBorder" Property="Background" Value="#252A33" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusBorder" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StudioComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioHover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioAccentSurface}" /><Setter Property="Foreground" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StudioComboBox" TargetType="ComboBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource StudioComboBoxItem}" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="Background" Value="{StaticResource StudioInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioStroke}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="12,8,36,8"
                                          IsHitTestVisible="False" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                        <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" Style="{x:Null}" OverridesDefaultStyle="True"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"><Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource StudioSecondary}" StrokeThickness="1.4"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" /></Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource StudioSurface}" BorderBrush="#49515F" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#596373" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StudioTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="CaretBrush" Value="{StaticResource StudioAccent}" />
        <Setter Property="Background" Value="{StaticResource StudioInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioStroke}" />
        <Setter Property="SelectionBrush" Value="#80544F" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" MinHeight="0" Padding="0" Margin="0" VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
        <Setter Property="Background" Value="{StaticResource StudioAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioAccent}" />
        <Setter Property="Foreground" Value="#26120F" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,13" />
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="RecordGlyph" Width="11" Height="11" Fill="{TemplateBinding Foreground}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <Rectangle x:Name="StopGlyph" Visibility="Collapsed" Width="11" Height="11" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Recording">
                            <Setter TargetName="RecordGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StopGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="White" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource StudioAccent}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource StudioInput}" />
        <Setter Property="Foreground" Value="{StaticResource StudioText}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioStroke}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</ResourceDictionary>
