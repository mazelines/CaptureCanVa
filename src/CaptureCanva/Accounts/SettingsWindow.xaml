<Window x:Class="CaptureCanva.Accounts.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경설정"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,20">
        <TabControl x:Name="Tabs">

            <!-- ────────────────────────── 계정 연동 ────────────────────────── -->
            <TabItem Header="계정 연동">
                <StackPanel Margin="4,14,4,4">

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Text="YouTube" />
                    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="YouTubeStatusText" Text="연결되지 않음" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Opacity="0.6" Margin="0,3,0,0"
                                           Text="녹화 영상을 내 채널에 업로드 (비공개 권장)" />
                            </StackPanel>
                            <Button x:Name="YouTubeConnectButton" Grid.Column="1" Margin="8,0,0,0"
                                    Content="연결" Padding="14,7" Click="OnYouTubeConnect" />
                            <Button x:Name="YouTubeDisconnectButton" Grid.Column="2" Margin="6,0,0,0"
                                    Content="연결 해제" Padding="14,7" Visibility="Collapsed" Click="OnYouTubeDisconnect" />
                        </Grid>
                    </Border>

                    <!-- Google Drive integration is temporarily hidden (code kept for future
                         re-enable). Re-enable requires ALL of: Visibility="Visible" on this
                         panel, Visibility="Visible" on UploadDriveCheck in MainWindow.xaml,
                         and DriveFeatureGate.Enabled = true. -->
                    <StackPanel x:Name="DriveSection" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,6" Text="Google Drive" />
                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DriveStatusText" Text="연결되지 않음" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Opacity="0.6" Margin="0,3,0,0"
                                               Text="녹화 파일을 Drive에 백업 (링크 공유 가능)" />
                                </StackPanel>
                                <Button x:Name="DriveConnectButton" Grid.Column="1" Margin="8,0,0,0"
                                        Content="연결" Padding="14,7" Click="OnDriveConnect" />
                                <Button x:Name="DriveDisconnectButton" Grid.Column="2" Margin="6,0,0,0"
                                        Content="연결 해제" Padding="14,7" Visibility="Collapsed" Click="OnDriveDisconnect" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,4" Text="Google API 연결 안내" />
                    <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" LineHeight="17"
                               Text="연결하려면 Google Cloud Console에서 OAuth 클라이언트(데스크톱 앱)가 필요합니다. 프로그램 폴더의 google-oauth-client.json에 client_id(및 선택적으로 client_secret)를 넣어 주세요. 승인은 브라우저에서 진행되며 refresh token은 Windows 사용자 계정(DPAPI)으로 암호화되어 이 PC에서만 해독됩니다." />

                </StackPanel>
            </TabItem>

            <!-- ────────────────────────── 단축키 ────────────────────────── -->
            <TabItem Header="단축키">
                <StackPanel Margin="4,14,4,4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="녹화 시작/중지" />
                        <TextBox x:Name="RecordHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                 GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                                 PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                                 ToolTip="클릭 후 원하는 키 조합을 누르세요" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="지우기" Click="OnClearRecordHotkey" />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="일시정지/계속" />
                        <TextBox x:Name="PauseHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                 GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                                 PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                                 ToolTip="클릭 후 원하는 키 조합을 누르세요 (없음 가능)" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="지우기" Click="OnClearPauseHotkey" />
                    </Grid>

                    <TextBlock x:Name="HotkeyHintText" Margin="0,10,0,0" FontSize="11" Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="입력 상자를 클릭한 뒤 키 조합을 누르면 지정됩니다. 다른 프로그램이 같은 키를 쓰면 등록에 실패할 수 있습니다." />
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" />

                    <Button x:Name="HotkeyApplyButton" Margin="0,14,0,0" HorizontalAlignment="Right"
                            Content="단축키 적용" Padding="16,8" Click="OnApplyHotkeys" IsEnabled="False" />

                </StackPanel>
            </TabItem>

        </TabControl>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AccountStatusText" TextWrapping="Wrap" />
            <Button x:Name="CancelConnectButton" Grid.Column="1" Margin="10,0,0,0"
                    Content="연결 취소" Click="OnCancelConnect" Visibility="Collapsed" />
        </Grid>
    </StackPanel>
</Window>
