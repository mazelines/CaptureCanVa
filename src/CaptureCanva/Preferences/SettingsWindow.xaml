<Window x:Class="CaptureCanva.Preferences.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경설정 · CaptureCanva" Style="{StaticResource StudioWindow}" ThemeMode="Dark"
        Width="560" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,24,24">
            <TextBlock Text="나에게 맞는 단축키" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,24" Style="{StaticResource CaptionText}"
                       Text="다른 앱을 사용하는 중에도 녹화를 제어할 수 있습니다." />
            <Border Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Text="녹화 시작/중지" />
                <TextBox Style="{StaticResource StudioTextBox}" x:Name="RecordHotkeyBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"
                         GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                         PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                         AutomationProperties.Name="녹화 시작과 중지 단축키"
                         ToolTip="클릭 후 원하는 키 조합을 누르세요" />
                <Button Style="{StaticResource StudioButton}" Grid.Column="2" Margin="8,0,0,10" Content="지우기" Click="OnClearRecordHotkey"
                        AutomationProperties.Name="녹화 단축키 지우기" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="일시정지/계속" />
                <TextBox Style="{StaticResource StudioTextBox}" x:Name="PauseHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                         GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                         PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                         AutomationProperties.Name="일시정지와 계속 단축키"
                         ToolTip="클릭 후 원하는 키 조합을 누르세요" />
                <Button Style="{StaticResource StudioButton}" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="지우기" Click="OnClearPauseHotkey"
                        AutomationProperties.Name="일시정지 단축키 지우기" />
            </Grid>
            </Border>
            <TextBlock x:Name="HotkeyHintText" Margin="0,16,0,0" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" LineHeight="18"
                       Text="입력 상자를 선택하고 키 조합을 누르세요. Esc로 입력을 취소하고, 지우기로 단축키를 해제할 수 있습니다. 변경 후 단축키 적용을 눌러 저장하세요." />
            <TextBlock x:Name="HotkeyStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource StudioAccent}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource StudioButton}" x:Name="HotkeyApplyButton" Content="단축키 적용" Padding="16,8"
                        Click="OnApplyHotkeys" IsEnabled="False" />
                <Button Style="{StaticResource StudioButton}" Content="닫기" Margin="8,0,0,0" Padding="16,8" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
