<Window x:Class="CaptureCanva.Preferences.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환경설정 · CaptureCanva"
        Width="520" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="단축키 설정" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Opacity="0.7"
                       Text="다른 앱을 사용하는 중에도 녹화를 제어할 수 있습니다." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Text="녹화 시작/중지" />
                <TextBox x:Name="RecordHotkeyBox" Grid.Column="1" IsReadOnly="True"
                         GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                         PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                         AutomationProperties.Name="녹화 시작과 중지 단축키"
                         ToolTip="클릭 후 원하는 키 조합을 누르세요" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="지우기" Click="OnClearRecordHotkey"
                        AutomationProperties.Name="녹화 단축키 지우기" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="일시정지/계속" />
                <TextBox x:Name="PauseHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                         GotKeyboardFocus="OnHotkeyBoxFocus" LostKeyboardFocus="OnHotkeyBoxBlur"
                         PreviewKeyDown="OnHotkeyBoxKeyDown" Cursor="Hand"
                         AutomationProperties.Name="일시정지와 계속 단축키"
                         ToolTip="클릭 후 원하는 키 조합을 누르세요" />
                <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Content="지우기" Click="OnClearPauseHotkey"
                        AutomationProperties.Name="일시정지 단축키 지우기" />
            </Grid>
            <TextBlock x:Name="HotkeyHintText" Margin="0,12,0,0" FontSize="12" Opacity="0.7"
                       TextWrapping="Wrap" LineHeight="18"
                       Text="입력 상자를 선택하고 키 조합을 누르세요. Esc로 입력을 취소하고, 지우기로 단축키를 해제할 수 있습니다. 변경 후 단축키 적용을 눌러 저장하세요." />
            <TextBlock x:Name="HotkeyStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="HotkeyApplyButton" Content="단축키 적용" Padding="16,8"
                        Click="OnApplyHotkeys" IsEnabled="False" />
                <Button Content="닫기" Margin="8,0,0,0" Padding="16,8" IsCancel="True" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
