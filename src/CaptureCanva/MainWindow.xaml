<Window x:Class="CaptureCanva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CaptureCanva" Style="{StaticResource StudioWindow}" ThemeMode="Dark"
        Width="620" Height="900" MinWidth="560" MinHeight="480"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="68" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource StudioBackground}" BorderBrush="{StaticResource StudioStroke}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Native caption behavior is retained by WindowChrome. -->
            <Grid Margin="24,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34" Margin="0,0,12,0">
                        <Path Data="M1,10 V1 H10 M24,1 H33 V10 M33,24 V33 H24 M10,33 H1 V24"
                              Stroke="{StaticResource StudioText}" StrokeThickness="2" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource StudioAccent}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="CaptureCanva" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="화면 녹화 · MP4 + GIF" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource SettingsIcon}" Click="OnOpenSettings"
                            IsEnabled="{Binding IsEnabled, ElementName=OutputActionsPanel}" Margin="0,0,10,0"
                            AutomationProperties.Name="환경설정" ToolTip="환경설정 · 단축키 변경" />
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource MinimizeIcon}" Click="OnMinimizeWindow"
                            AutomationProperties.Name="최소화" ToolTip="최소화" />
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource CloseIcon}" Click="OnCloseWindow"
                            AutomationProperties.Name="닫기" ToolTip="닫기" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="24,0,24,16">
                    <Border Style="{StaticResource Surface}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="녹화할 화면" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="CAPTURE" Style="{StaticResource CaptionText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Background="{StaticResource StudioBackground}" CornerRadius="10" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ModeMonitor" Style="{StaticResource ModeButton}" Tag="{StaticResource MonitorIcon}"
                                                 GroupName="Mode" Content="전체 화면" Checked="OnModeChanged" />
                                    <RadioButton x:Name="ModeWindow" Style="{StaticResource ModeButton}" Tag="{StaticResource WindowIcon}"
                                                 GroupName="Mode" Content="특정 창" Checked="OnModeChanged" />
                                    <RadioButton x:Name="ModeRegion" Style="{StaticResource ModeButton}" Tag="{StaticResource RegionIcon}"
                                                 GroupName="Mode" Content="영역 지정" Checked="OnModeChanged" />
                                </UniformGrid>
                            </Border>
                            <Grid Margin="0,12,0,0">
                                <ComboBox Style="{StaticResource StudioComboBox}" x:Name="MonitorList" DisplayMemberPath="Display" AutomationProperties.Name="녹화할 모니터" />
                                <Grid x:Name="WindowPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource StudioComboBox}" x:Name="WindowList" DisplayMemberPath="Display" DropDownOpened="OnWindowListOpened" AutomationProperties.Name="녹화할 창" />
                                    <Button Style="{StaticResource StudioButton}" Grid.Column="1" Margin="8,0,0,0" Content="새로고침" Click="OnRefreshWindows" />
                                </Grid>
                                <Grid x:Name="RegionPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RegionText" VerticalAlignment="Center" Foreground="{StaticResource StudioSecondary}" Text="선택된 영역 없음" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource StudioButton}" Grid.Column="1" Content="영역 선택" Click="OnSelectRegion" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="영상과 소리" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="EncoderText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="인코더 확인 중…" FontSize="11" Foreground="{StaticResource StudioSecondary}"
                                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="프레임" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource StudioComboBox}" x:Name="FpsList" AutomationProperties.Name="녹화 프레임">
                                        <ComboBoxItem Content="15 fps" Tag="15" /><ComboBoxItem Content="24 fps" Tag="24" />
                                        <ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="화질" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource StudioComboBox}" x:Name="QualityList" AutomationProperties.Name="녹화 화질">
                                        <ComboBoxItem Content="높음" Tag="High" /><ComboBoxItem Content="보통" Tag="Normal" />
                                        <ComboBoxItem Content="낮음 · 작은 파일" Tag="Low" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <CheckBox Style="{StaticResource StudioCheckBox}" x:Name="SystemAudioCheck" Content="시스템 소리" />
                                <CheckBox Style="{StaticResource StudioCheckBox}" x:Name="MicCheck" Content="마이크" />
                                <CheckBox Style="{StaticResource StudioCheckBox}" x:Name="CursorCheck" Content="마우스 커서" />
                            </UniformGrid>
                            <CheckBox Style="{StaticResource StudioCheckBox}" x:Name="HideSelfCheck" Margin="0,2,0,0" Content="영상에서 이 창 숨기기"
                                      Checked="OnHideSelfChanged" Unchecked="OnHideSelfChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GIF도 함께 저장" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="블로그와 보고서에 바로 쓸 수 있도록" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource StudioCheckBox}" x:Name="CreateGifCheck" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="녹화 완료 후 GIF 함께 저장"
                                          Checked="OnCreateGifChanged" Unchecked="OnCreateGifChanged" />
                            </Grid>
                            <ComboBox Style="{StaticResource StudioComboBox}" x:Name="GifPresetList" IsEnabled="False" AutomationProperties.Name="GIF 저장 프리셋">
                                <ComboBoxItem Content="문서용 · 360px / 10 fps" Tag="Small" />
                                <ComboBoxItem Content="블로그용 · 480px / 12 fps" Tag="Standard" />
                                <ComboBoxItem Content="고화질 · 640px / 15 fps" Tag="HighQuality" />
                                <ComboBoxItem Content="원본 크기 · 15 fps" Tag="OriginalSize" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="저장 위치" FontSize="12" Foreground="{StaticResource StudioSecondary}" VerticalAlignment="Center" />
                        <WrapPanel x:Name="OutputActionsPanel" Grid.Column="1">
                            <Button Style="{StaticResource StudioButton}" Content="변경" Padding="10,5" MinHeight="28" Click="OnChangeOutputDir" ToolTip="저장 폴더 변경" />
                            <Button Style="{StaticResource StudioButton}" Content="폴더 열기" Tag="{StaticResource FolderIcon}" Padding="10,5" MinHeight="28" Margin="6,0,0,0" Click="OnOpenOutputDir" />
                            <Button Tag="{StaticResource LogIcon}" Style="{StaticResource TitleButton}" Margin="6,0,0,0" Height="28" MinHeight="28" Width="28"
                                    Click="OnOpenLogs" ToolTip="로그 열기" AutomationProperties.Name="로그 열기" />
                        </WrapPanel>
                    </Grid>
                    <TextBox Style="{StaticResource StudioTextBox}" x:Name="OutputDirText" IsReadOnly="True" TextWrapping="NoWrap" Margin="0,8,0,0" FontSize="12"
                             Foreground="{StaticResource StudioSecondary}" Background="{StaticResource StudioBackground}"
                             AutomationProperties.Name="저장 폴더" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- The primary recording action stays visible while settings scroll. -->
            <Border x:Name="RecordingDock" Grid.Row="2" Background="#171A20" BorderBrush="{StaticResource StudioStroke}" BorderThickness="0,1,0,0" Padding="24,16,24,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse x:Name="RecDot" Width="6" Height="6" Margin="0,0,7,0" Fill="{StaticResource RecordBrush}" Opacity="0.25" />
                                <TextBlock x:Name="RecordingStateText" Text="준비 중" FontSize="11" Foreground="{StaticResource StudioSecondary}" />
                            </StackPanel>
                            <TextBlock x:Name="TimerText" FontFamily="Cascadia Mono, Consolas" FontSize="30" FontWeight="Medium" Text="00:00:00" />
                        </StackPanel>
                        <Button Style="{StaticResource StudioButton}" x:Name="PauseButton" Grid.Column="1" Margin="10,0,8,0" Padding="13,14" Tag="{StaticResource PauseIcon}"
                                Content="일시정지" IsEnabled="False" Click="OnPauseClick" VerticalAlignment="Center" />
                        <Button x:Name="RecordButton" Grid.Column="2" Style="{StaticResource RecordButton}" Content="녹화 시작"
                                IsEnabled="False" Click="OnRecordClick" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="HotkeyText" Margin="0,10,0,0" Style="{StaticResource CaptionText}" FontSize="11" />
                    <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource StudioSecondary}" AutomationProperties.LiveSetting="Polite" />
                            <Grid x:Name="GifProgressPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ProgressBar Height="4" VerticalAlignment="Center" IsIndeterminate="True" Foreground="{StaticResource StudioAccent}" />
                                <Button Style="{StaticResource StudioButton}" x:Name="CancelGifButton" Grid.Column="1" Margin="12,0,0,0" Content="변환 취소" Click="OnCancelGif" />
                            </Grid>
                            <TextBlock x:Name="LastFileLink" Margin="0,6,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=LastFileText}">
                                <Run Text="MP4  ·  " Foreground="{StaticResource StudioSecondary}" /><Hyperlink Foreground="{StaticResource StudioAccent}" Click="OnOpenLastFile"><Run x:Name="LastFileText" /></Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="LastGifFileLink" Margin="0,6,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=LastGifFileText}">
                                <Run Text="GIF   ·  " Foreground="{StaticResource StudioSecondary}" /><Hyperlink Foreground="{StaticResource StudioAccent}" Click="OnOpenLastGifFile"><Run x:Name="LastGifFileText" /></Hyperlink>
                            </TextBlock>
                            <Button Style="{StaticResource StudioButton}" x:Name="RetryGifButton" Margin="0,8,0,0" HorizontalAlignment="Left" Content="GIF 다시 만들기" Click="OnRetryGif" Visibility="Collapsed"
                                    ToolTip="저장된 MP4로 선택한 프리셋의 GIF를 다시 만듭니다" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource StudioButton}" x:Name="MazelineBanner" Grid.Row="3" Margin="24,12,24,16" Click="OnOpenMazelineWebsite"
                    Background="{StaticResource StudioBackground}" BorderBrush="Transparent" Padding="0" MinHeight="34"
                    HorizontalContentAlignment="Stretch" AutomationProperties.Name="메이즈라인 홈페이지 열기"
                    ToolTip="메이즈라인 홈페이지 열기 · https://www.mazeline.tech/">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource StudioInput}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource StudioAccent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                        <Canvas Width="120" Height="120">
                            <Rectangle Canvas.Left="7" Canvas.Top="24" Width="10" Height="78" Fill="#B8BECA" />
                            <Rectangle Canvas.Left="23" Canvas.Top="24" Width="10" Height="78" Fill="#B8BECA" />
                            <Rectangle Canvas.Left="39" Canvas.Top="46" Width="10" Height="56" Fill="#B8BECA" />
                            <Rectangle Canvas.Left="55" Canvas.Top="68" Width="10" Height="34" Fill="#AC8DE8" />
                            <Rectangle Canvas.Left="71" Canvas.Top="46" Width="10" Height="56" Fill="#B8BECA" />
                            <Rectangle Canvas.Left="87" Canvas.Top="24" Width="10" Height="78" Fill="#B8BECA" />
                            <Rectangle Canvas.Left="103" Canvas.Top="24" Width="10" Height="78" Fill="#B8BECA" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MAZELINE" FontSize="11" FontWeight="SemiBold" Foreground="#C3C9D4" />
                        <TextBlock Text="  ·  게임과 피지컬 AI" FontSize="11" Foreground="{StaticResource StudioSecondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="mazeline.tech ↗" FontSize="11" Foreground="{StaticResource StudioSecondary}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>
